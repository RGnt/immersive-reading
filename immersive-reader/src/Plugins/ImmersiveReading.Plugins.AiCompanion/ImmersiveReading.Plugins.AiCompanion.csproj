<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\ImmersiveReading.Core\ImmersiveReading.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="settings.defaults.json" />
    <EmbeddedResource Include="settings.schema.json" />
    <EmbeddedResource Include="Migrations\*.sql" />
    <EmbeddedResource Include="Assets\**\*" />
    <!-- UI source is compiled to Assets\ui.js by `npm run build:plugins`; only the output ships. -->
    <EmbeddedResource Remove="Assets\**\*.src.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

