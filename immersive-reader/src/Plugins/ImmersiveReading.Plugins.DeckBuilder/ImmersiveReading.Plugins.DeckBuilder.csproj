  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImmersiveReading.App.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
