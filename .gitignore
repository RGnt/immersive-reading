ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.Spotlight-V100
.Trashes

# Editor & IDE Directories
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# ==========================================
# .NET / C# Build Artifacts
# ==========================================
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.lock.json
project.lock.json
project.assets.json
*.nuget.props
*.nuget.targets

# Immersive Reader Runtime Application Data & Local Databases
immersive-reader/.library-data/
.library-data/
*.db
*.db-wal
*.db-shm

# ==========================================
# Python Artifacts & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.cache/
.pytest_cache/
.coverage
.coverage.*
.hypothesis/
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.pyo

# Enrichement Extractor Output & Publications
enrichement-extractor/output/
enrichement-extractor/.cache/
enrichement-extractor/.enrichment/
enrichement-extractor/tmp/
tmp/
*.tmp

