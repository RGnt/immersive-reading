# ==========================================
# Immersive Reading - Root .gitignore
# ==========================================

# Operating System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.Spotlight-V100
.Trashes

# Editor & IDE Directories
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# ==========================================
# .NET / C# Build Artifacts
# ==========================================
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.lock.json
project.lock.json
project.assets.json
*.nuget.props
*.nuget.targets

# Immersive Reader Runtime Application Data & Local Databases
immersive-reader/.library-data/
.library-data/
**/.library-data/
*.db
**/*.db
*.db-wal
**/*.db-wal
*.db-shm
**/*.db-shm
*.db-journal
**/*.db-journal
*.sqlite
**/*.sqlite
*.sqlite3
**/*.sqlite3
**/library.db
**/dictionaries.db
**/vocabulary.db

# ==========================================
# Python Artifacts & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.cache/
.pytest_cache/
.coverage
.coverage.*
.hypothesis/
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.pyo

# ==========================================
# Input Material (Books, EPUBs, Decks, User CSVs)
# ==========================================
books/
**/books/
enrichement-extractor/books/
*.epub
*.mobi
*.azw3
*.cbz
*.cbr

# User CSV and TSV vocabulary/mining decks
*.tsv
*.csv
# Keep reference dictionaries under enrichement-extractor/data/ tracked
!enrichement-extractor/data/**

# ==========================================
# Generated Pipeline Outputs & Artifacts
# ==========================================
dist/
**/dist/
immersive-reader/dist/
output/
**/output/
enrichement-extractor/output/
enrichement-extractor/.cache/
enrichement-extractor/.enrichment/
enrichement-extractor/tmp/
enrichement-extractor/dist/
tmp/
*.tmp
*.pdf
*.zip
# Keep reference assets under enrichement-extractor/data/ tracked
!enrichement-extractor/data/**
